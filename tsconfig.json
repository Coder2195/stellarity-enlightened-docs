{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"jsx": "preserve",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"lib": ["ESNext", "DOM"],
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["vite/client", "node"]
	},
	"vueCompilerOptions": {
		"vitePressExtensions": [".md"]
	},
	"include": [
		"docs/**/*.ts",
		"docs/**/*.vue",
		"docs/**/*.md",
		"docs/.vitepress/**/*.ts",
		"docs/.vitepress/**/*.vue"
	],
	"exclude": ["node_modules", "docs/.vitepress/dist", "docs/.vitepress/cache"]
}
